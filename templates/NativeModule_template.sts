import { callCallback } from "./CallbackRegistry"
import { int32 } from "@koalaui/compat"
import { KInt, KPointer, KStringPtr, KUint8ArrayPtr } from "@koalaui/interop"

let theModule: NativeModule

export function nativeModule(): NativeModule {
    if (theModule) return theModule
    // todo: is this code actually reachable?
    theModule = new NativeModule()
    return theModule
}

export class NativeModule {
  static {
    loadLibrary("NativeBridgeArk")
    NativeModule.init();
  }

  static native init(): void;

  static callCallbackFromNative(id: int32, args: KUint8ArrayPtr, length: int32): int32 {
    return callCallback(id, args, length)
  }

  static native _LoadVirtualMachine(classPath: String, libPath: String, kind: int32): long;
  static native _RunVirtualMachine(env: long, what: int32, arg0: int32): int32;
  static native _CallExternalAPI(env: long, what: int32, buffer: KUint8ArrayPtr, len: int32): int32;
  static native _SetCallbackMethod(method: long): void;

%GENERATED_METHODS%

  static native _StringLength(arg1: long): int32;
  static native _StringData(arg1: long, arg2: KUint8ArrayPtr, arg3: int32): void;
  static native _StringMake(arg1: String): long;
  static native _ManagedStringWrite(value: String, arg1: KUint8ArrayPtr, arg2: int32): int32;
  static native _GetStringFinalizer(): long;
  static native _InvokeFinalizer(arg1: long, arg2: long): void;
  static native _GetNodeFinalizer(): long;
  static native _GetPtrVectorSize(arg1: long): int32;
  static native _GetPtrVectorElement(arg1: long, arg2: int32): long;
  static native _GetGroupedLog(arg1: int32): long;
  static native _StartGroupedLog(arg1: int32): void;
  static native _StopGroupedLog(arg1: int32): void;
  static native _StartPerf(traceName: String): void;
  static native _EndPerf(traceName: String): void;
  static native _DumpPerf(options: int32): long;
  static native _GetNodeByViewStack(): long;

  static native _TestPerfNumber(arg1: int32): int32;
  static native _TestPerfNumberWithArray(arg1: KUint8ArrayPtr, arg2: int32): void;
  static native _Test_TextPicker_OnAccept(valueArray: KUint8ArrayPtr, valueSerializerLength: int32): void;
  static native _Test_SetEventsApi(): void;
  static native _Test_List_OnScrollVisibleContentChange(valueArray: KUint8ArrayPtr, valueSerializerLength: int32): void;
  static native _Test_Common_OnChildTouchTest(valueArray: KUint8ArrayPtr, valueSerializerLength: int32): void;
  static native _TestCallIntNoArgs(arg1: int32): int32
  static native _TestCallIntInt32ArraySum(arg1: int32, arg2: int32[], arg3: int32): int32
  static native _TestCallVoidInt32ArrayPrefixSum(arg1: int32, arg2: int32[], arg3: int32): void
  static native _TestCallIntRecursiveCallback(arg1: int32, arg2: KUint8ArrayPtr, arg3: int32): int32
  static native _TestCallIntMemory(arg1: int32, arg2: int32): int32

  static native _SetCreateNodeDelay(type: int32, nanoseconds: long): void
  static native _SetMeasureNodeDelay(type: int32, nanoseconds: long): void
  static native _SetLayoutNodeDelay(type: int32, nanoseconds: long): void
  static native _SetDrawNodeDelay(type: int32, nanoseconds: long): void

  // BasicNodeAPI
  static native _CreateNode(type: int32, id: int32, flags: int32): long
  static native _DisposeNode(ptr: long): void
  static native _DumpTreeNode(ptr: long): void
  static native _ApplyModifierFinish(ptr: long): void
  static native _Dump(nodePtr: long): void
  static native _AddChild(parent: long, child: long): int32
  static native _RemoveChild(parent: long, child: long): void
  static native _InsertChildAfter(parent: long, child: long, sibling: long): int32
  static native _InsertChildBefore(parent: long, child: long, sibling: long): int32
  static native _InsertChildAt(parent: long, child: long, position: int32): int32
  static native _UnRegisterNodeAsyncEvent(nodePtr: long , kind: int32 ): void
  static native _RegisterNodeAsyncEventReceiver(eventReceiver: long ): void
  static native _UnRegisterNodeAsyncEventReceiver(): void
  static native _MarkDirty( nodePtr:long,  dirtyFlag:int): void
  static native _IsBuilderNode( nodePtr:long): boolean
  static native _ConvertLengthMetricsUnit(value: float, originUnit: int32, targetUnit: int32): float

  // ExtendedNodeAPI
  static native _SetCustomCallback(node: long, callbackId: int32): void
  static native _MeasureLayoutAndDraw(root: long): void
  static native _MeasureNode(root: long, data: float[]): int32
  static native _LayoutNode(root: long, data: float[]): int32
  static native _DrawNode(root: long, data: float[]): int32

  // setAttachNodePtr
  // getAttachNodePtr

  static native _SetMeasureWidth(root: long, value: int32): void
  static native _GetMeasureWidth(root: long): int32
  static native _SetMeasureHeight(root: long, value: int32): void
  static native _GetMeasureHeight(root: long): int32
  static native _SetX(root: long, value: int32): void
  static native _GetX(root: long): int32
  static native _SetY(root: long, value: int32): void
  static native _GetY(root: long): int32

  // getLayoutConstraint

  static native _SetAlignment(root: long, value: int32): void
  static native _GetAlignment(root: long): int32

  static native _IndexerChecker(node: long): int32

  static native _SetRangeUpdater(node: long, updaterId: int32): void
  static native _SetLazyItemIndexer(node: long, indexerId: int32): int32

  static native _SetVsyncCallback(long: long, callbackId: int32): int32
  static native _UnblockVsyncWait(long: long): int

  // _CheckArkoalaEvents -> checkEvent
  static native _CheckEvents(result: KUint8ArrayPtr, count: int32): int32
  // _SendArkoalaEvent -> sedEvent
  static native _SendEvent(event: KUint8ArrayPtr, count: int32): void

  static native _SetChildTotalCount(ptr: long, value: int32): void

  // _Dump
  static native _ShowCrash(messagePtr: String): void

  static native _GetPipelineContext(nodePtr: long): long
}