{
    "compilerOptions": {
        "target": "es2017",
        "lib": ["ESNext", "ESNext.WeakRef"],
        "moduleResolution": "node",
        "composite": true,
        "incremental": true,
        "declarationMap": true,
        "sourceMap": true,
        "declaration": true,
        "noEmitOnError": true,
        "strict": true,
        "skipLibCheck": true,
        "removeComments": false,
        "outDir": "build/peers",
        "module": "CommonJS",
        "baseUrl": ".",
        "paths": {
            "@arkoala/arkui": ["./peers/full/generated", "./"],
            "@arkoala/arkui/*": ["./peers/full/generated/*", "./*"],
        },
    },
    "include": [
        "peers/full/**/*",
        "sdk/component/**/*",
    ]
}
