    },
    "include": [
        "./generated/subset/koalaui/arkoala-arkui/arkts/src/*.ets",
        "./generated/subset/koalaui/arkoala-arkui/arkts/src/peers/*.ets",
        "./generated/subset/koalaui/arkoala-arkui/arkts/src/shared/ArkResource.ets",
