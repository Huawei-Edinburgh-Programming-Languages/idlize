{
    "compilerOptions": {
        "outDir": "build/abc/arkts-subset",
        "rootDir": "./generated/arkts-subset",
        "paths": {
            "@arkoala/arkui": ["./generated/arkts-subset", "./"],
            "@arkoala/arkui/*": ["./generated/arkts-subset/*", "./*"],
            "@koalaui/arkoala": ["node_modules/@koalaui/arkoala"],
            "@koalaui/common": ["node_modules/@koalaui/common"],
            "@koalaui/interop": ["node_modules/@koalaui/interop"],
            "@koalaui/runtime": ["node_modules/@koalaui/runtime"]
        }
    },
    "include": ["./generated/arkts-subset/**/*.ets"]
}
