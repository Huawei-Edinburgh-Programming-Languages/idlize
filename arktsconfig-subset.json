{
    "compilerOptions": {
        "outDir": "build/abc/subset",
        "rootDir": "./out/arkts-subset/generated",
        "paths": {
            "@arkoala/arkui": ["./out/arkts-subset/generated/sig/arkoala-arkts/arkui/src", "./"],
            "@arkoala/arkui/*": ["./out/arkts-subset/generated/sig/arkoala-arkts/arkui/src/*", "./*"],
            "@koalaui/arkoala": ["./out/arkts-subset/generated/sig/arkoala-arkts/framework/src"],
            "@koala/interop": ["./out/arkts-subset/generated/sig/arkoala-arkts/arkui/src/interop"],
            "@koala/common": ["./out/arkts-subset/generated/sig/arkoala-arkts/arkui/src/common"],
            "@koalaui/runtime": ["./out/arkts-subset/generated/sig/incremental/src/runtime"]
        }
    },
    "include": ["out/arkts-subset/generated/**/*.ets"],
    "exclude": ["out/arkts-subset/generated/sig/arkoala/arkui/arkts/src/shared/dts-exports.ets"]
}
