package ohos.promptAction;

dictionary LevelMode {
    number OVERLAY = 0;
    number EMBEDDED = 1;
};
dictionary ImmersiveMode {
    number DEFAULT = 0;
    number EXTEND = 1;
};

[Entity=Class]
interface LevelOrder {
    constructor();
    static LevelOrder clamp(number order);
    number getOrder();
};

[DefaultExport]
namespace promptAction {
    [Entity=Class]
    interface CommonController {
        constructor();
        void close();
    };
    [Entity=Class]
    interface DialogController: [Extends] CommonController {
        constructor();
    };
};
