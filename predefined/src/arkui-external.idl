[Entity=Interface, TypeParameters="T"]
interface Callback {
    [CallSignature]
    void invoke(T data);
};
[Entity=Interface, TypeParameters="T extends Error = BusinessError"]
interface ErrorCallback {
    [CallSignature]
    void invoke(T err);
};
[Entity=Interface, TypeParameters="T,E = void"]
interface AsyncCallback {
    [CallSignature]
    void invoke([TypeArguments="E"] BusinessError err, T data);
};
[Entity=Interface, TypeParameters="T = void"]
interface BusinessError: Error {
    attribute number code;
    [Optional]
    attribute T data;
};