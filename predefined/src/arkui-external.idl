};
// [Namespace=drawing, Entity=Class]
[Entity=Class]
interface Region {
    boolean isPointContained(number x, number y);
    boolean isRegionContained(Region other);
    boolean op(Region region, RegionOp regionOp);
    boolean quickReject(number left, number top, number right, number bottom);
    boolean setPath(Path path, Region clip);
    boolean setRect(number left, number top, number right, number bottom);
};
// [Namespace=drawing]
dictionary RegionOp {
    number DIFFERENCE = 0;
    number INTERSECT = 1;
    number UNION = 2;
    number XOR = 3;
    number REVERSE_DIFFERENCE = 4;
    number REPLACE = 5;
};
// [Namespace=drawing]
dictionary CornerPos {
    number TOP_LEFT_POS = 0;
    number TOP_RIGHT_POS = 1;
    number BOTTOM_RIGHT_POS = 2;
    number BOTTOM_LEFT_POS = 3;
};
// [Namespace=drawing]
dictionary SrcRectConstraint {
    number STRICT = 0;
    number FAST = 1;
};

[Entity=Class]
interface DrawingCanvas : Canvas {
};
[Entity=Class]
interface DrawingColorFilter : ColorFilter {
};
[Entity=Class]
interface DrawingLattice : Lattice {
};


[Entity=Class, Component="ImageModifier"]
interface ImageModifier: ImageAttribute {
    [Optional]
    void applyNormalAttribute(ImageAttribute instance);
};
[Entity=Class, Component="Image"]
interface ImageAttribute: [TypeArguments="ImageAttribute"] CommonMethod {
    [CommonMethod]
    attribute (String or Resource or PixelMap) alt;
    [CommonMethod]
    attribute boolean matchTextDirection;
    [CommonMethod]
    attribute boolean fitOriginalSize;
    [CommonMethod]
    attribute ResourceColor fillColor;
    [CommonMethod]
    attribute ImageFit objectFit;
    [CommonMethod]
    attribute ImageRepeat objectRepeat;
    [CommonMethod]
    attribute boolean autoResize;
    [CommonMethod]
    attribute ImageRenderMode renderMode;
    [CommonMethod]
    attribute DynamicRangeMode dynamicRangeMode;
    [CommonMethod]
    attribute ImageInterpolation interpolation;
    [CommonMethod]
    attribute Literal_Number_height_width sourceSize;
    [CommonMethod]
    attribute boolean syncLoad;
    [CommonMethod]
    attribute (ColorFilter or DrawingColorFilter) colorFilter;
    [CommonMethod]
    attribute CopyOptions copyOption;
    [CommonMethod]
    attribute boolean draggable;
    [CommonMethod]
    attribute PointLightStyle pointLight;
    [CommonMethod]
    attribute number edgeAntialiasing;
    [CommonMethod]
    attribute Callback_Type_ImageAttribute_onComplete_callback_event_Void onComplete;
    [CommonMethod]
    attribute ImageErrorCallback onError;
    [CommonMethod]
    attribute Callback_Void onFinish;
    [CommonMethod]
    attribute boolean enableAnalyzer;
    [CommonMethod]
    attribute ImageAnalyzerConfig analyzerConfig;
    [CommonMethod]
    attribute ResizableOptions resizable;
    [CommonMethod]
    attribute boolean privacySensitive;
    [CommonMethod]
    attribute ResolutionQuality enhancedImageQuality;
};

