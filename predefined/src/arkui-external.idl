[Entity=Interface]
interface WorkerOptions {
    [Optional]
    attribute String type;
    [Optional]
    attribute String name;
    [Optional]
    attribute boolean shared;
};
[Entity=Interface]
interface Event {
    readonly attribute String type;
    readonly attribute number timeStamp;
};
[Entity=Interface]
interface ErrorEvent: Event {
    readonly attribute String message;
    readonly attribute String filename;
    readonly attribute number lineno;
    readonly attribute number colno;
    readonly attribute Object error;
};
[Entity=Interface]
interface MessageEvents: Event {
    readonly attribute undefined data;
};
[Entity=Interface]
interface PostMessageOptions {
    [Optional]
    attribute sequence<Object> transfer;
};
[Entity=Interface, Deprecated]
interface EventListener {
    [Deprecated, CallSignature]
    async void invoke(Event evt);
};
[Entity=Interface]
interface WorkerEventListener {
    [CallSignature]
    async void invoke(Event event);
};
[Synthetic]
callback Callback_ErrorEvent_Void = void (ErrorEvent ev);
[Synthetic]
callback Callback_Number_Void = void (number code);
[Synthetic]
callback Callback_MessageEvents_Void = void (MessageEvents event);
[Synthetic]
callback Callback_Args_Void = void (Args... args);
[Entity=Class, TypeParameters="Args extends Object[]"]
interface WrappedBuilder {
    constructor(Callback_Args_Void builder);
    attribute Callback_Args_Void builder;
};
// [Namespace=worker, Entity=Class]
[Entity=Class]
interface ThreadWorker {
    constructor(String scriptURL, optional WorkerOptions options);
    [Optional]
    attribute Callback_Number_Void onexit;
    [Optional]
    attribute Callback_ErrorEvent_Void onerror;
    [Optional]
    attribute Callback_MessageEvents_Void onmessage;
    [Optional]
    attribute Callback_MessageEvents_Void onmessageerror;
    void postMessage(Object message, sequence<ArrayBuffer> transfer);
    void postMessage(Object message, optional PostMessageOptions options);
    void postMessageWithSharedSendable(Object message, optional sequence<ArrayBuffer> transfer);
    void on(String type, WorkerEventListener listener);
    void once(String type, WorkerEventListener listener);
    void off(String type, optional WorkerEventListener listener);
    void terminate();
    void addEventListener(String type, WorkerEventListener listener);
    boolean dispatchEvent(Event event);
    void removeEventListener(String type, optional WorkerEventListener callback_);
    void removeAllListener();
    void registerGlobalCallObject(String instanceName, Object globalCallObject);
    void unregisterGlobalCallObject(optional String instanceName);
};
// [Namespace=worker, Entity=Class]
[Entity=Class]
interface RestrictedWorker: ThreadWorker {
    constructor(String scriptURL, optional WorkerOptions options);
};


