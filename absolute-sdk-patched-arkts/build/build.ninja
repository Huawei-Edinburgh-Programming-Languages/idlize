
rule arkts_compiler
    command = /home/huawei/work/idlize_copy/external/incremental/tools/panda/arkts/ui2abc  --ets-module --arktsconfig /home/huawei/work/idlize_copy/absolute-sdk-patched-arkts/build/arktsconfig-_proceed_to_binary.json --output $out --simultaneous @$out.rsp
    rspfile = $out.rsp
    rspfile_content = $in
    description = "Compiling ARKTS $out"


rule arkts_linker
    command = /home/huawei/work/idlize_copy/external/incremental/tools/panda/arkts/arklink --output $out -- @$out.rsp
    rspfile = $out.rsp
    rspfile_content = $in_newline
    description = "Linking ARKTS $out"


